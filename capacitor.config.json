{
  "appId": "il.ac.ruppin.konan",
  "appName": "כונן רופין",
  "webDir": "www",
  "server": {
    "url": "https://rupwpub.ruppin.ac.il/landpages/it/konan-home.html",
    "errorPath": "offline.html",
    "allowNavigation": ["ruppin.ac.il", "*.ruppin.ac.il"]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#1B6B4F",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
